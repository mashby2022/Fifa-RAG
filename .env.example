APP_NAME="World Cup RAG Shell"
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
AUTO_INGEST_ON_STARTUP=false
LOCAL_DATA_DIR=data
INCLUDE_OPENFOOTBALL_DOCS=false
INITIAL_RETRIEVAL_K=30

# Comma-separated origins. Add your Lovable preview and production URLs here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://fifa-fan-chatter.lovable.app,https://*.lovable.app,https://*.lovableproject.com

# Vector backend options: memory, milvus
VECTOR_BACKEND=memory
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=worldcup_docs

# Embedding provider options: local_hash, nvidia
EMBEDDING_PROVIDER=nvidia
EMBEDDING_DIM=384
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Generator provider options: extractive, nvidia
GENERATOR_PROVIDER=nvidia
NVIDIA_GENERATOR_MODEL=meta/llama-3.1-70b-instruct

# Reranker provider options: none, nvidia
RERANKER_PROVIDER=none
NVIDIA_RERANKER_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NVIDIA_RERANKER_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking

# Optional Phase 5 data bundle downloads for Render.
DATA_BUNDLE_URL=
RAW_DATA_ZIP_URL=
PROCESSED_DATA_ZIP_URL=
INDEXES_DATA_ZIP_URL=
